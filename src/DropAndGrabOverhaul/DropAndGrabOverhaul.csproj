<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Most appropriate target framework for the game's Unity version. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>bobabulkerENTERPRISE.DropAndGrabOverhaul</AssemblyName>
    <AssemblyTitle>DropAndGrabOverhaul</AssemblyTitle>
    <!-- Single source of truth for the release version: PackTS passes it to tcli as the package version. -->
    <Version>0.2.9</Version>
  </PropertyGroup>

  <!-- Mod files to copy to the relative BepInEx directory after build -->
  <ItemGroup>
    <DeployModFiles Include="$(TargetPath)" BepInExDir="plugins/" />
  </ItemGroup>
</Project>
